HOST="127.0.0.1"
PORT="8090"
CONTEXT_LENGTH="4096"
MIN_TOKENS_PER_SECOND="15"

# Laisser vide pour la répartition automatique proportionnelle à la VRAM.
# Exemple uniquement après mesure de l'ordre réel des GPU :
# TENSOR_SPLIT="32,32,32,16"
TENSOR_SPLIT=""

FALLBACK_MODEL="qwen3.5:122b"
